/**app.wxss**/
page {
  background-color: #F5F5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 通用按钮样式 */
.btn-primary {
  background-color: #4A90E2;
  color: #FFFFFF;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 32rpx;
  border: none;
}

.btn-primary:active {
  background-color: #3A7BC8;
}

.btn-secondary {
  background-color: #FFFFFF;
  color: #4A90E2;
  border: 2rpx solid #4A90E2;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 32rpx;
}

.btn-danger {
  background-color: #FF6B6B;
  color: #FFFFFF;
  border-radius: 8rpx;
  padding: 20rpx 40rpx;
  font-size: 32rpx;
  border: none;
}

/* 卡片样式 */
.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.card-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 24rpx;
}

.card-content {
  font-size: 28rpx;
  color: #5A6C7D;
  line-height: 1.6;
}

/* 文本样式 */
.text-primary {
  color: #4A90E2;
}

.text-danger {
  color: #FF6B6B;
}

.text-success {
  color: #4ECDC4;
}

.text-warning {
  color: #F5A623;
}

.text-muted {
  color: #95A5A6;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
}

.tag-primary {
  background-color: #EBF3FF;
  color: #4A90E2;
}

.tag-danger {
  background-color: #FFECEC;
  color: #FF6B6B;
}

.tag-warning {
  background-color: #FFF8E6;
  color: #F5A623;
}

/* 分隔线 */
.divider {
  height: 2rpx;
  background-color: #E5E5E5;
  margin: 32rpx 0;
}

/* 加载样式 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #95A5A6;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  color: #D0D0D0;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #95A5A6;
}
