/* pages/settings/settings.wxss */
.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  margin: 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.user-desc {
  font-size: 24rpx;
  opacity: 0.9;
}

.settings-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 28rpx;
  color: #7F8C8D;
  padding: 24rpx 32rpx 16rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  margin: 0 24rpx 24rpx;
  cursor: pointer;
  transition: all 0.3s;
}

.setting-item:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.setting-label {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.setting-icon {
  font-size: 48rpx;
}

.setting-text {
  flex: 1;
}

.setting-name {
  font-size: 32rpx;
  color: #2C3E50;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.setting-desc {
  font-size: 24rpx;
  color: #95A5A6;
}

.setting-value {
  font-size: 28rpx;
  color: #4A90E2;
}

.setting-arrow {
  font-size: 32rpx;
  color: #B0B0B0;
}

.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 32rpx;
}

.footer-text {
  font-size: 28rpx;
  color: #5A6C7D;
  margin-bottom: 12rpx;
}

.footer-copyright {
  font-size: 24rpx;
  color: #95A5A6;
}
