<!--pages/settings/settings.wxml-->
<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card card">
    <view class="user-avatar">👤</view>
    <view class="user-info">
      <view class="user-name">{{userInfo.nickName || '未登录'}}</view>
      <view class="user-desc">记录每一次争吵，理解彼此</view>
    </view>
  </view>

  <!-- 设置选项 -->
  <view class="settings-section">
    <view class="section-title">隐私设置</view>

    <view class="setting-item card">
      <view class="setting-label">
        <view class="setting-icon">🔒</view>
        <view class="setting-text">
          <view class="setting-name">数据存储位置</view>
          <view class="setting-desc">选择数据保存的位置</view>
        </view>
      </view>
      <picker
        mode="selector"
        range="{{storageOptions}}"
        range-key="label"
        value="{{storageIndex}}"
        bindchange="onStorageChange"
      >
        <view class="setting-value">
          {{storageOptions[storageIndex].label}} >
        </view>
      </picker>
    </view>

    <view class="setting-item card">
      <view class="setting-label">
        <view class="setting-icon">🔔</view>
        <view class="setting-text">
          <view class="setting-name">通知时机</view>
          <view class="setting-desc">何时推送分析结果</view>
        </view>
      </view>
      <picker
        mode="selector"
        range="{{notificationOptions}}"
        range-key="label"
        value="{{notificationIndex}}"
        bindchange="onNotificationChange"
      >
        <view class="setting-value">
          {{notificationOptions[notificationIndex].label}} >
        </view>
      </picker>
    </view>
  </view>

  <!-- 数据管理 -->
  <view class="settings-section">
    <view class="section-title">数据管理</view>

    <view class="setting-item card" bindtap="exportData">
      <view class="setting-label">
        <view class="setting-icon">📤</view>
        <view class="setting-text">
          <view class="setting-name">导出数据</view>
          <view class="setting-desc">导出所有吵架记录</view>
        </view>
      </view>
      <view class="setting-arrow">></view>
    </view>

    <view class="setting-item card" bindtap="clearAllData">
      <view class="setting-label">
        <view class="setting-icon">🗑️</view>
        <view class="setting-text">
          <view class="setting-name">清空所有数据</view>
          <view class="setting-desc text-danger">删除所有记录，不可恢复</view>
        </view>
      </view>
      <view class="setting-arrow">></view>
    </view>
  </view>

  <!-- 关于 -->
  <view class="settings-section">
    <view class="section-title">关于</view>

    <view class="setting-item card">
      <view class="setting-label">
        <view class="setting-icon">ℹ️</view>
        <view class="setting-text">
          <view class="setting-name">版本信息</view>
          <view class="setting-desc">v1.0.0</view>
        </view>
      </view>
    </view>

    <view class="setting-item card" bindtap="showHelp">
      <view class="setting-label">
        <view class="setting-icon">❓</view>
        <view class="setting-text">
          <view class="setting-name">使用帮助</view>
          <view class="setting-desc">如何使用这个小程序</view>
        </view>
      </view>
      <view class="setting-arrow">></view>
    </view>

    <view class="setting-item card" bindtap="showPrivacy">
      <view class="setting-label">
        <view class="setting-icon">🛡️</view>
        <view class="setting-text">
          <view class="setting-name">隐私政策</view>
          <view class="setting-desc">了解我们如何保护你的隐私</view>
        </view>
      </view>
      <view class="setting-arrow">></view>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="footer">
    <view class="footer-text">吵架记录 - 让沟通更顺畅</view>
    <view class="footer-copyright">© 2025 All Rights Reserved</view>
  </view>
</view>
